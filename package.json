{
   "name": "baoproject",
   "version": "0.1.0",
   "private": true,
   "workspaces": [
      "src/client",
      "src/server"
   ],
   "scripts": {
      "dev": "concurrently 'npm run dev:server' 'npm run dev:client'",
      "dev:client": "npm run dev --workspace=src/client",
      "dev:server": "npm run dev --workspace=src/server",
      "build": "npm run build --workspace=src/client",
      "test": "npm run test:unit && npm run test:integration && npm run test:regression && npm run test:performance",
      "test:integration": "jest --testPathPattern=tests/integration --runInBand --forceExit --testTimeout=30000",
      "test:performance": "jest --testPathPattern=tests/performance --runInBand --forceExit --testTimeout=120000",
      "test:regression": "jest --testPathPattern=tests/regression --runInBand --forceExit --testTimeout=30000",
      "test:unit": "jest --testPathPattern=tests/unit --runInBand --forceExit --testTimeout=10000",
      "db:migrate": "npm run db:migrate --workspace=src/server",
      "db:seed": "npm run db:seed --workspace=src/server",
      "db:reset": "npm run db:reset --workspace=src/server",
      "db:setup": "npm run db:setup --workspace=src/server",
      "db:reset-full": "npm run db:reset-full --workspace=src/server",
      "scraper": "node scripts/scrape-vnexpress.js"
   },
   "jest": {
      "testEnvironment": "node",
      "testMatch": [
         "**/tests/integration/**/*.test.js",
         "**/tests/performance/**/*.test.js",
         "**/tests/regression/**/*.test.js",
         "**/tests/unit/**/*.test.js"
      ],
      "verbose": true
   },
   "devDependencies": {
      "autocannon": "^8.0.0",
      "concurrently": "^10.0.0",
      "husky": "^9.1.7",
      "jest": "^27.5.1",
      "lint-staged": "^17.0.7",
      "prettier": "^3.8.3",
      "supertest": "^7.2.2"
   },
   "lint-staged": {
      "*.{js,jsx,json,md,css,html}": "prettier --write"
   }
}
